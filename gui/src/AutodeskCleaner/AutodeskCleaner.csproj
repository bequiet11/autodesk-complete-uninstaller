<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>AutodeskCleaner</RootNamespace>
    <AssemblyName>AutodeskCleaner</AssemblyName>
    <ApplicationIcon>Assets\Autodesk.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <Authors>Petruk-code</Authors>
    <Company>Autodesk Cleaner (community fork)</Company>
    <Product>Autodesk Cleaner</Product>
    <Description>Beginner-friendly Windows GUI for the Autodesk Complete Uninstaller engine.</Description>
    <Copyright>MIT License</Copyright>
    <SatelliteResourceLanguages>en;id</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\..\autodesk_complete_uninstaller.bat"
                      LogicalName="AutodeskCleaner.Engine.autodesk_complete_uninstaller.bat" />
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\app.png" />
    <Resource Include="Assets\Autodesk.ico" />
  </ItemGroup>

</Project>
