<Window x:Class="AutodeskCleaner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Autodesk Cleaner"
        Width="1280" Height="820"
        MinWidth="1024" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/Autodesk.ico">
    <Window.Resources>
        <DataTemplate x:Key="ProductItemTemplate">
            <Border Style="{StaticResource ProductRow}" Width="auto" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="110" />
                    </Grid.ColumnDefinitions>

                    <Border Width="34" Height="34" CornerRadius="17" Background="{Binding AccentHex, Converter={StaticResource HexBrush}}">
                        <TextBlock Text="{Binding Initial}" Foreground="White" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="{Binding VersionDisplay}" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="  •  " Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Text="{Binding Publisher}" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="Type" Style="{StaticResource Label}" />
                        <TextBlock Text="{Binding TypeLabel}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,3,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="3" VerticalAlignment="Center">
                        <TextBlock Text="Size" Style="{StaticResource Label}" />
                        <TextBlock Text="{Binding SizeText}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,3,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="4" VerticalAlignment="Center">
                        <TextBlock Text="Info" Style="{StaticResource Label}" />
                        <TextBlock Text="{Binding InfoText}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,3,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{StaticResource PageBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="0,8,0,20">
                    <Border Width="36" Height="36" CornerRadius="10" Background="#1D4ED8">
                        <TextBlock Text="A" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0">
                        <TextBlock Text="Autodesk Cleaner" Foreground="White" FontWeight="SemiBold" FontSize="18" />
                        <TextBlock Text="Windows cleanup engine" Foreground="{StaticResource SidebarMutedBrush}" FontSize="11" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <Border Grid.Row="1" CornerRadius="12" Background="{StaticResource SidebarRaisedBrush}" Padding="12" Margin="0,0,0,18">
                    <StackPanel>
                        <TextBlock Text="Engine status" Foreground="{StaticResource SidebarMutedBrush}" Style="{StaticResource SidebarLabel}" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Ellipse Width="10" Height="10" Fill="#22C55E" Margin="0,0,8,0" />
                            <TextBlock Text="Ready to scan" Foreground="White" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock Text="Runs as Administrator and preserves registry backups" Foreground="{StaticResource SidebarMutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="2" Margin="0,0,0,18">
                    <TextBlock Text="Workspace" Foreground="{StaticResource SidebarMutedBrush}" Style="{StaticResource SidebarLabel}" Margin="0,0,0,10" />
                    <Button Content="Installed products" Height="38" Style="{StaticResource SecondaryButton}" Background="{StaticResource SidebarActiveBrush}" Foreground="White" BorderThickness="0" HorizontalContentAlignment="Left" Padding="14,0" Margin="0,0,0,8" />
                    <Button Content="Repair tools" Height="38" Style="{StaticResource SecondaryButton}" Background="Transparent" Foreground="{StaticResource SidebarTextBrush}" BorderThickness="0" HorizontalContentAlignment="Left" Padding="14,0" Margin="0,0,0,8" />
                    <Button Content="Settings" Height="38" Style="{StaticResource SecondaryButton}" Background="Transparent" Foreground="{StaticResource SidebarTextBrush}" BorderThickness="0" HorizontalContentAlignment="Left" Padding="14,0" />
                </StackPanel>

                <Border Grid.Row="3" CornerRadius="12" Padding="12" Background="{StaticResource SidebarRaisedBrush}">
                    <StackPanel>
                        <TextBlock Text="Embedded engine" Foreground="{StaticResource SidebarMutedBrush}" Style="{StaticResource SidebarLabel}" />
                        <TextBlock Text="autodesk_complete_uninstaller.bat" Foreground="White" Margin="0,8,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="28,20,28,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="180" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Installed Autodesk products" Style="{StaticResource H1}" />
                    <TextBlock Text="Select products to remove or run full cleanup with verification." Style="{StaticResource Body}" Margin="0,6,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="RescanButton" Content="Rescan" Style="{StaticResource SecondaryButton}" Width="110" Margin="0,0,10,0" Click="Rescan_Click" />
                    <Button x:Name="UninstallSelectedButton" Content="Uninstall selected" Style="{StaticResource PrimaryButton}" Width="150" Click="UninstallSelected_Click" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,18,0,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="Products found" Style="{StaticResource Label}" />
                        <TextBlock x:Name="ProductsCountText" Text="0" Style="{StaticResource H2}" Margin="0,4,0,0" />
                        <TextBlock Text="detected in registry" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="10,0,10,0">
                        <TextBlock Text="Estimated size" Style="{StaticResource Label}" />
                        <TextBlock x:Name="TotalSizeText" Text="0 MB" Style="{StaticResource H2}" Margin="0,4,0,0" />
                        <TextBlock Text="from installer metadata" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="10,0,10,0">
                        <TextBlock Text="Remnants" Style="{StaticResource Label}" />
                        <TextBlock x:Name="RemnantsText" Text="0" Style="{StaticResource H2}" Margin="0,4,0,0" />
                        <TextBlock Text="flagged for attention" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="3" Margin="10,0,0,0">
                        <TextBlock Text="Last scan" Style="{StaticResource Label}" />
                        <TextBlock x:Name="LastScanText" Text="Never" Style="{StaticResource H2}" Margin="0,4,0,0" />
                        <TextBlock Text="local registry snapshot" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="SearchBox" Height="40" Padding="12,8" VerticalContentAlignment="Center" FontSize="14"
                             TextChanged="SearchBox_TextChanged" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" Background="White" />

                    <Button x:Name="FullCleanButton" Grid.Column="1" Content="Full clean" Style="{StaticResource PrimaryButton}" Width="140" Margin="12,0,0,0" Click="FullClean_Click" />
                    <Button x:Name="DeepCleanButton" Grid.Column="2" Content="Deep clean" Style="{StaticResource SecondaryButton}" Width="140" Margin="12,0,0,0" Click="DeepClean_Click" />
                </Grid>

                <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="12">
                    <Grid>
                        <ListBox x:Name="ProductList"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionMode="Extended"
                                 ItemTemplate="{StaticResource ProductItemTemplate}"
                                 ItemsSource="{Binding ProductsView}" />

                        <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                            <TextBlock Text="No Autodesk products detected" Style="{StaticResource H2}" HorizontalAlignment="Center" />
                            <TextBlock Text="Run a full deep-clean to remove lingering Autodesk files and registry entries." Style="{StaticResource Body}" Margin="0,8,0,0" Width="420" TextAlignment="Center" TextWrapping="Wrap" />
                            <Button Content="Run Deep Clean" Style="{StaticResource PrimaryButton}" Margin="0,18,0,0" HorizontalAlignment="Center" Click="DeepClean_Click" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="3" Style="{StaticResource CardBorder}" Margin="0,18,0,0" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Background="#0F172A" CornerRadius="14,14,0,0" Padding="14,10">
                        <DockPanel>
                            <TextBlock Text="Activity log" Foreground="White" FontWeight="SemiBold" />
                            <Button x:Name="StopButton" Content="Stop" DockPanel.Dock="Right"
                                    Style="{StaticResource SecondaryButton}" Padding="12,4"
                                    Visibility="Collapsed" Click="Stop_Click" />
                            <TextBlock x:Name="ActionStatusText" DockPanel.Dock="Right"
                                       Text="Ready" Foreground="#A9BAD1" Margin="0,0,14,0"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>

                    <ScrollViewer x:Name="LogScrollViewer" Grid.Row="1" Background="#0B1220" VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="LogTextBox" Text="Ready. Your last scan or action will appear here."
                                   Foreground="#D7E2F5" Margin="14" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
